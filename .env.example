# Copy to .env and fill in real values. Never commit .env.

# --- Airflow admin bootstrap (airflow-init container) ---
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@stamm.local

# Airflow 3 API auth — generate with: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=change-me

# Host UID used by the Airflow containers (Linux only; leave 50000 on Windows/macOS).
AIRFLOW_UID=50000

# --- InfluxDB (external stack) ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=stamm_org
INFLUXDB_TOKEN=YOUR_SECURE_TOKEN
INFLUXDB_BUCKET_RAW=stamm_raw
INFLUXDB_BUCKET_METADATA=stamm_metadata
INFLUXDB_BUCKET_PRED=stamm_predictions

# --- Model Registry (separate FastAPI + Streamlit service) ---
MODEL_REGISTRY_API_BASE=http://model-registry:8000
MODEL_REGISTRY_PROJECT_ID=P0001
MODEL_REGISTRY_TIMEOUT_SECONDS=30
MODEL_REGISTRY_VERIFY_TLS=true

# --- STAMM backend API (in development — see docs/dags.md) ---
STAMM_API_BASE=http://stamm-api:8000
